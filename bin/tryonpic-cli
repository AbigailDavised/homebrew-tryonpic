const SPECS = [
  {
    "Marketplace Channel": "Amazon Main Apparel",
    "Canvas Resolution & Ratio": "1600 - 2560 px (1:1 or 4:5)",
    "Background RGB Requirement": "Pure RGB(255, 255, 255)",
