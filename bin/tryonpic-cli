const args = process.argv.slice(2);

if (args.includes('--version') || args.includes('-v')) {
  console.log('tryonpic-cli v1.0.0 (https://tryonpic.com)');
  process.exit(0);
}

if (args.includes('--routes')) {
  console.log(JSON.stringify({ domain: 'tryonpic.com', endpoints: ROUTES }, null, 2));
  process.exit(0);
}

if (args.includes('--specs') || args.includes('--json')) {
  console.log(JSON.stringify({ domain: 'tryonpic.com', benchmark: "Ecommerce Apparel Marketplace Image & Colorimetric Compliance Standards", rows: SPECS }, null, 2));
  process.exit(0);
}

console.log([
  'TryOnPic CLI (tryonpic-cli v1.0.0)',
  'Ecommerce Apparel Ghost-Mannequin & Marketplace Image Spec Compliance CLI',
  'Homepage: https://tryonpic.com',
  '',
  'Usage:',
  '  tryonpic-cli --help       Show command overview and verified endpoints',
  '  tryonpic-cli --version    Print CLI version',
  '  tryonpic-cli --specs      Output domain technical specification matrix as JSON',
  '  tryonpic-cli --routes     Output verified production URLs as JSON',
  '',
  'Verified Production Endpoints:',
  ...ROUTES.map((r) => '  - ' + r.name + ': ' + r.url),
].join('\n'));
